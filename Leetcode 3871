class Solution {
    public long countCommas(long n) {
        if(n < 1000) return 0;
        long count = 0, count1 = 0, count2 = 0, count3 = 0, count4 = 0;
        if(n <= 999999) {
            count = (n - 1000 + 1) * 1;
        }
        if(n > 999999 && n <= 999999999) {
            count = (999999 - 1000 + 1) * 1;
            count1 = (n - 1000000 + 1) * 2;
        }
        if(n > 999999999 && n <= 999999999999L) {
            count = (999999 - 1000 + 1) * 1;
            count1 = (999999999 - 1000000 + 1) * 2;
            count2 = (n - 1000000000L + 1) * 3;
        }
        if(n > 999999999999L && n <= 999999999999999L) {
            count = (999999 - 1000 + 1) * 1;
            count1 = (999999999 - 1000000 + 1) * 2;
            count2 = (999999999999L - 1000000000L + 1) * 3;
            count3 = (n - 1000000000000L + 1) * 4;
        }
        if(n > 999999999999999L) {
            count = (999999 - 1000 + 1) * 1;
            count1 = (999999999 - 1000000 + 1) * 2;
            count2 = (999999999999L - 1000000000L + 1) * 3;
            count3 = (999999999999999L - 1000000000000L + 1) * 4;
            count4 = (n - 1000000000000000L + 1) * 5;
        }
        return count + count1 + count2 + count3 + count4;
    }
}
