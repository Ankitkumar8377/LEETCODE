class Solution {
    public int matrixScore(int[][] arr) {
        int m = arr.length;
        int n = arr[0].length;
        // Make first column all 1s
        for(int i = 0; i < m; i++) {
            if(arr[i][0] == 0) {
                for(int j = 0; j < n; j++) {
                    arr[i][j] = 1 - arr[i][j];
                }
            }
        }
        // Make every remaining column have maximum 1s
        for(int j = 1; j < n; j++) {
            int noOfZeroes = 0;
            int noOfOnes = 0;
            for(int i = 0; i < m; i++) {
                if(arr[i][j] == 0) noOfZeroes++;
                else noOfOnes++;
            }
            // Flip column if it contains more 0s
            if(noOfZeroes > noOfOnes) {
                for(int i = 0; i < m; i++) {
                    arr[i][j] = 1 - arr[i][j];
                }
            }
        }
        // Calculate score
        int score = 0;
        int x = 1;
        for(int j = n - 1; j >= 0; j--) {
            for(int i = 0; i < m; i++) {
                score += (arr[i][j] * x);
            }
            x *= 2;
        }
        return score;
    }
}
