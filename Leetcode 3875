//Brute Force Approach

class Solution {
    public boolean uniformArray(int[] nums1) {
        int N = nums1.length;
        int[] nums2 = new int[N];
        int j = 0;
        for(int i = 0;i<N;i++){
            if(i+1<N) j = i+1;
            nums2[i] = nums1[i] - nums1[j];
        }
        boolean flag = true,flag1= true;
        for(int i = 0;i<N;i++){
            if(nums2[i]%2!=0) flag = false;
        }
        for(int i = 0;i<N;i++){
            if(nums2[i]%2!=0) flag1 = false;
        }
        return flag==flag1;
    }
}
